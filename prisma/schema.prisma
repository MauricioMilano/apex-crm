generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  slug         String        @unique
  logo         String?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  apiKeys      ApiKey[]
  appointments Appointment[]
  auditLogs    AuditLog[]
  clients      Client[]
  forms        Form[]
  leadStatuses LeadStatus[]
  leads        Lead[]
  locations    Location[]
  services            Service[]
  subscriptionPlans   SubscriptionPlan[]
  users               User[]
  webhooks            Webhook[]
  organizationSettings OrganizationSetting?
  emailTemplates      EmailTemplate[]
  emailSchedules      EmailSchedule[]

  @@map("organizations")
}

model Location {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  name           String
  address        String?
  city           String?
  state          String?
  zip            String?
  phone          String?
  email          String?
  timezone       String        @default("America/Chicago")
  currency       String?       @map("currency")
  isActive       Boolean       @default(true) @map("is_active")
  isDefault      Boolean       @default(false) @map("is_default")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  appointments   Appointment[]
  blockedSlots   BlockedSlot[]
  clients        Client[]
  leads          Lead[]
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          User[]

  @@map("locations")
}

model User {
  id               String           @id @default(cuid())
  organizationId   String           @map("organization_id")
  locationId       String?          @map("location_id")
  email            String           @unique
  passwordHash     String?          @map("password_hash")
  magicLinkToken   String?          @map("magic_link_token")
  magicLinkExpires DateTime?        @map("magic_link_expires")
  role             UserRole         @default(employee)
  firstName        String           @map("first_name")
  lastName         String           @map("last_name")
  phone            String?
  avatar           String?
  isActive         Boolean          @default(true) @map("is_active")
  resetToken       String?          @map("reset_token")
  resetTokenExpires DateTime?       @map("reset_token_expires")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  appointments     Appointment[]    @relation("EmployeeAppointments")
  auditLogs        AuditLog[]
  clientFiles      ClientFile[]
  clientsAssigned  Client[]         @relation("ClientAssignee")
  employeeProfile  EmployeeProfile?
  leadsAssigned    Lead[]           @relation("LeadAssignee")
  location         Location?        @relation(fields: [locationId], references: [id])
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("users")
}

model EmployeeProfile {
  id            String            @id @default(cuid())
  userId        String            @unique @map("user_id")
  bio           String?
  workingHours  Json              @default("{}") @map("working_hours")
  bufferMinutes Int               @default(0) @map("buffer_minutes")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  blockedSlots  BlockedSlot[]
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  services      EmployeeService[]

  @@map("employee_profiles")
}

model Service {
  id               String            @id @default(cuid())
  organizationId   String            @map("organization_id")
  name             String
  description      String?
  duration         Int
  price            Decimal           @db.Decimal(10, 2)
  color            String?
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  appointments           Appointment[]
  employeeServices       EmployeeService[]
  planServices           SubscriptionPlanService[]
  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("services")
}

model EmployeeService {
  id             String          @id @default(cuid())
  employeeId     String          @map("employee_id")
  serviceId      String          @map("service_id")
  customDuration Int?            @map("custom_duration")
  customPrice    Decimal?        @map("custom_price") @db.Decimal(10, 2)
  createdAt      DateTime        @default(now()) @map("created_at")
  employee       EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceId])
  @@map("employee_services")
}

model LeadStatus {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  color          String       @default("#6366f1")
  order          Int          @default(0)
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads          Lead[]

  @@map("lead_statuses")
}

model Lead {
  id                  String        @id @default(cuid())
  organizationId      String        @map("organization_id")
  locationId          String?       @map("location_id")
  statusId            String        @map("status_id")
  assignedTo          String?       @map("assigned_to")
  firstName           String        @map("first_name")
  lastName            String        @map("last_name")
  email               String?
  phone               String?
  company             String?
  source              String?
  notes               String?
  value               Decimal?      @db.Decimal(10, 2)
  tags                String[]      @default([])
  convertedToClientId String?       @map("converted_to_client_id")
  formId              String?       @map("form_id")
  customFields        Json          @default("{}") @map("custom_fields")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  appointments        Appointment[]
  assignee            User?         @relation("LeadAssignee", fields: [assignedTo], references: [id])
  form                Form?         @relation(fields: [formId], references: [id])
  location            Location?     @relation(fields: [locationId], references: [id])
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status              LeadStatus    @relation(fields: [statusId], references: [id])

  @@map("leads")
}

model Client {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  locationId     String?       @map("location_id")
  assignedTo     String?       @map("assigned_to")
  leadId         String?       @map("lead_id")
  firstName      String        @map("first_name")
  lastName       String        @map("last_name")
  email          String?
  phone          String?
  company        String?
  address        String?
  city           String?
  state          String?
  zip            String?
  notes          String?
  tags           String[]      @default([])
  isActive       Boolean       @default(true) @map("is_active")
  customFields   Json          @default("{}") @map("custom_fields")
  billingInfo    Json          @default("{}") @map("billing_info")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  appointments        Appointment[]
  clientSubscriptions ClientSubscription[]
  files               ClientFile[]
  assignee       User?         @relation("ClientAssignee", fields: [assignedTo], references: [id])
  location       Location?     @relation(fields: [locationId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("clients")
}

model ClientFile {
  id             String   @id @default(cuid())
  clientId       String   @map("client_id")
  uploadedBy     String   @map("uploaded_by")
  fileName       String   @map("file_name")
  fileUrl        String   @map("file_url")
  fileType       String   @map("file_type")
  fileSize       Int?     @map("file_size")
  createdAt      DateTime @default(now()) @map("created_at")
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  uploadedByUser User     @relation(fields: [uploadedBy], references: [id])

  @@map("client_files")
}

model Form {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  description    String?
  fields         Json         @default("[]")
  styling        Json         @default("{}")
  isPublished    Boolean      @default(false) @map("is_published")
  embedCode      String?      @map("embed_code")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leads          Lead[]

  @@map("forms")
}

model Appointment {
  id             String            @id @default(cuid())
  organizationId String            @map("organization_id")
  locationId     String?           @map("location_id")
  clientId       String?           @map("client_id")
  employeeId     String            @map("employee_id")
  serviceId      String            @map("service_id")
  status         AppointmentStatus @default(pending)
  startTime      DateTime          @map("start_time")
  endTime        DateTime          @map("end_time")
  notes          String?
  cancelReason   String?           @map("cancel_reason")
  clientSubscriptionId String?           @map("client_subscription_id")
  recurringId          String?           @map("recurring_id")
  createdAt            DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  leadId         String?           @map("lead_id")
  client             Client?             @relation(fields: [clientId], references: [id])
  clientSubscription ClientSubscription? @relation(fields: [clientSubscriptionId], references: [id])
  employee           User                @relation("EmployeeAppointments", fields: [employeeId], references: [id])
  lead           Lead?             @relation(fields: [leadId], references: [id])
  location       Location?         @relation(fields: [locationId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service        Service           @relation(fields: [serviceId], references: [id])

  @@map("appointments")
}

model BlockedSlot {
  id         String          @id @default(cuid())
  employeeId String          @map("employee_id")
  locationId String?         @map("location_id")
  startTime  DateTime        @map("start_time")
  endTime    DateTime        @map("end_time")
  reason     String?
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")
  employee   EmployeeProfile @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  location   Location?       @relation(fields: [locationId], references: [id])

  @@map("blocked_slots")
}

model Webhook {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  url            String
  events         String[]     @default([])
  secret         String?
  isActive       Boolean      @default(true) @map("is_active")
  lastTriggered  DateTime?    @map("last_triggered")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

model ApiKey {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  keyHash        String       @map("key_hash")
  keyPrefix      String       @map("key_prefix")
  permissions    String[]     @default([])
  lastUsedAt     DateTime?    @map("last_used_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  userId         String       @map("user_id")
  action         String
  entityType     String       @map("entity_type")
  entityId       String?      @map("entity_id")
  details        Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SubscriptionPlan {
  id                String                    @id @default(cuid())
  organizationId    String                    @map("organization_id")
  name              String
  description       String?
  price             Decimal                   @db.Decimal(10, 2)
  billingPeriod     BillingPeriod             @default(monthly)
  maxApptsPerPeriod Int?                      @map("max_appts_per_period")
  isActive          Boolean                   @default(true) @map("is_active")
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")

  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  planServices        SubscriptionPlanService[]
  clientSubscriptions ClientSubscription[]

  @@map("subscription_plans")
}

model SubscriptionPlanService {
  id           String            @id @default(cuid())
  planId       String            @map("plan_id")
  serviceId    String            @map("service_id")
  maxPerPeriod Int?              @map("max_per_period")

  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  service Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([planId, serviceId])
  @@map("subscription_plan_services")
}

model ClientSubscription {
  id                 String              @id @default(cuid())
  clientId           String              @map("client_id")
  planId             String              @map("plan_id")
  status             SubscriptionStatus  @default(active)
  startDate          DateTime            @default(now()) @map("start_date")
  endDate            DateTime?           @map("end_date")
  currentPeriodStart DateTime            @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime            @map("current_period_end")
  appointmentsUsed   Int                 @default(0) @map("appointments_used")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  client       Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  plan         SubscriptionPlan   @relation(fields: [planId], references: [id])
  appointments Appointment[]

  @@map("client_subscriptions")
}

model OrganizationSetting {
  id              String   @id @default(cuid())
  organizationId  String   @unique @map("organization_id")
  smtpEnabled     Boolean  @default(false) @map("smtp_enabled")
  smtpHost        String?  @map("smtp_host")
  smtpPort        Int?     @default(587) @map("smtp_port")
  smtpUser        String?  @map("smtp_user")
  smtpPass        String?  @map("smtp_pass")
  smtpFrom        String?  @map("smtp_from")
  smtpSecure              Boolean  @default(false) @map("smtp_secure")
  emailVerificationEnabled Boolean @default(false) @map("email_verification_enabled")

  // ── Regional settings ──────────────────────────────────────────────────
  currency      String  @default("USD") @map("currency")
  timezone      String  @default("America/New_York") @map("timezone")
  dateFormat    String  @default("MM/DD/YYYY") @map("date_format")
  timeFormat    String  @default("12h") @map("time_format")
  locale        String? @default("en-US") @map("locale")

  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

model EmailTemplate {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  name            String
  subject         String
  bodyHtml        String   @map("body_html")
  category        String
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@map("email_templates")
}

model EmailSchedule {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  templateName    String   @map("template_name")
  to              String
  variables       Json     @default("{}")
  scheduledFor    DateTime @map("scheduled_for")
  sentAt          DateTime? @map("sent_at")
  referenceType   String?  @map("reference_type")
  referenceId     String?  @map("reference_id")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("email_schedules")
}

enum BillingPeriod {
  monthly
  quarterly
  semiannual
  annual

  @@map("billing_period")
}

enum SubscriptionStatus {
  active
  cancelled
  expired

  @@map("subscription_status")
}

enum UserRole {
  super_admin
  admin
  employee
  client

  @@map("user_role")
}

enum AppointmentStatus {
  pending
  confirmed
  completed
  cancelled
  no_show

  @@map("appointment_status")
}
